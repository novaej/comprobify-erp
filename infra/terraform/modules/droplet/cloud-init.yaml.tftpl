#cloud-config
# First boot of a comprobify droplet (ADR-048): an unprivileged deploy user, Docker from its
# own apt repository, SSH hardening, swap, fail2ban and automatic security updates. Changes here
# reach a droplet only through a deliberate replacement (main.tf, lifecycle).
users:
  - name: ${deploy_username}
    lock_passwd: true
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/comprobify-environment
    content: |
      ${environment}
  # Ubuntu 24.04 ("noble"), as image_slug pins.
  - path: /etc/apt/sources.list.d/docker.list
    content: |
      deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable
  # A drop-in, not an edit of sshd_config. The deploy user runs docker through its group only;
  # there is no sudo and no root login, so a leaked key has no path to root.
  - path: /etc/ssh/sshd_config.d/99-comprobify.conf
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      KbdInteractiveAuthentication no
      UsePAM yes
      MaxAuthTries 3
      LoginGraceTime 30
      AllowUsers ${deploy_username}
  # Container logs rotate instead of filling the disk.
  - path: /etc/docker/daemon.json
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "20m", "max-file": "5"}}

runcmd:
  - mkdir -p /opt/comprobify
  - chown ${deploy_username}:${deploy_username} /opt/comprobify
  - fallocate -l ${swap_size} /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - echo 'vm.swappiness=10' >> /etc/sysctl.conf
  - sysctl -p
  # In runcmd with a lock timeout, not cloud-init's packages: an apt timer holding the lock at
  # boot would fail that module outright.
  - apt-get -o DPkg::Lock::Timeout=120 update
  - apt-get -o DPkg::Lock::Timeout=120 install -y ca-certificates curl
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - apt-get -o DPkg::Lock::Timeout=120 update
  - apt-get -o DPkg::Lock::Timeout=120 install -y fail2ban unattended-upgrades docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  # The docker group exists only after the package install.
  - usermod -aG docker ${deploy_username}
  - systemctl enable --now fail2ban
  - dpkg-reconfigure -f noninteractive unattended-upgrades
  - systemctl restart ssh
  - systemctl enable --now docker

# Staging and production (ADR-048): Cloudflare in front, Caddy here for TLS, the web app behind.
# Cloudflare's ranges are trusted for the client's address (the same list as the droplet's
# firewall, https://www.cloudflare.com/ips-v4); CF-Connecting-IP must be named or Caddy never
# reads it.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Every hostname of the environment, comma-separated in SITE_HOSTS (the landing and the app; the
# app's proxy sends each path to its host). One certificate per name, obtained by Caddy.
{$SITE_HOSTS} {
	encode zstd gzip
	reverse_proxy web:3000 {
		# The resolved client alone: the app reads the last X-Forwarded-For entry as the client
		# (apps/web/src/server/request.ts), which would otherwise be Cloudflare's edge.
		header_up X-Forwarded-For {client_ip}
	}
}

{
  "name": "@comprobify/worker",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc",
    "test-certificate": "tsx src/test-certificate.ts",
    "super-admin": "tsx --env-file-if-exists=../../.env src/super-admin.ts",
    "run-job": "tsx --env-file-if-exists=../../.env src/run-job.ts",
    "import:legacy": "tsx --env-file-if-exists=../../.env src/import-legacy.ts",
    "rotate:cert-key": "tsx --env-file-if-exists=../../.env src/rotate-cert-key.ts"
  },
  "dependencies": {
    "@comprobify/config": "workspace:*",
    "@comprobify/core": "workspace:*",
    "@comprobify/db": "workspace:*",
    "@sentry/node": "11.11.0",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}

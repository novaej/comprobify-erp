# Copy to .env. An empty value counts as unset.

# local, staging or production. Separate from tenant mode (PRD 7.4).
APP_ENV=local

# fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# json or pretty. pretty is for a local terminal; the Docker image only has json.
LOG_FORMAT=pretty

# Public URL of the web app.
APP_URL=http://localhost:3000

# App role: web and worker. Never a superuser or BYPASSRLS.
DATABASE_URL=postgres://comprobify_erp_app:changeme@localhost:5432/comprobify_erp_local

# Owner role: the migrate step only.
MIGRATION_DATABASE_URL=postgres://comprobify_erp_owner:changeme@localhost:5432/comprobify_erp_local

# Integration tests. The database name must end in _test.
TEST_DATABASE_URL=postgres://comprobify_erp_app:changeme@localhost:5432/comprobify_erp_test
TEST_MIGRATION_DATABASE_URL=postgres://comprobify_erp_owner:changeme@localhost:5432/comprobify_erp_test

# Fakes SRI responses. Refused when APP_ENV is production.
SRI_MOCK_MODE=false

# Optional. Local development works without these.
SENTRY_DSN=
BETTERSTACK_SOURCE_TOKEN=
